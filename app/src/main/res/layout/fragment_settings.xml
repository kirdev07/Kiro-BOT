<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки: меню разделов; раздел открывается тем же фрагментом с аргументом section -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ===== Меню разделов ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_menu"
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout android:id="@+id/row_conversation" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_section_conversation" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/settings_section_conversation_desc" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_chats" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_section_chats" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/settings_section_chats_desc" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_protection" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_section_protection" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/settings_section_protection_desc" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_learning" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_section_learning" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/settings_section_learning_desc" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_developer" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_section_developer" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/settings_section_developer_desc" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Разговор ===== -->
        <LinearLayout
            android:id="@+id/group_conversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsCardContent">
                    <TextView style="@style/SettingsCardTitle" android:text="@string/personality_title" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_personality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button android:id="@+id/btn_personality_default" style="@style/SettingsToggleButton" android:text="@string/personality_default" />
                        <Button android:id="@+id/btn_personality_warm" style="@style/SettingsToggleButton" android:text="@string/personality_warm" />
                        <Button android:id="@+id/btn_personality_cheeky" style="@style/SettingsToggleButton" android:text="@string/personality_cheeky" />
                        <Button android:id="@+id/btn_personality_polite" style="@style/SettingsToggleButton" android:text="@string/personality_polite" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/SettingsDesc" android:text="@string/personality_desc" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_auto_mood"
                        style="@style/SettingsSwitch"
                        android:text="@string/auto_mood_switch" />

                    <TextView style="@style/SettingsDesc" android:text="@string/auto_mood_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsCardContent">
                    <TextView style="@style/SettingsCardTitle" android:text="@string/settings_fallback_title" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_fallback_strategy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button android:id="@+id/btn_fallback_silent" style="@style/SettingsToggleButton" android:text="@string/settings_fallback_silent" />
                        <Button android:id="@+id/btn_fallback_random" style="@style/SettingsToggleButton" android:text="@string/settings_fallback_random" />
                        <Button android:id="@+id/btn_fallback_error" style="@style/SettingsToggleButton" android:text="@string/settings_fallback_error" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/SettingsDesc" android:text="@string/settings_fallback_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== Беседы ===== -->
        <LinearLayout
            android:id="@+id/group_chats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsCardContent">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_chats"
                        style="@style/SettingsSwitch"
                        android:text="@string/settings_chats_switch" />

                    <TextView style="@style/SettingsDesc" android:text="@string/settings_chats_desc" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_chat_prefix_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/settings_chat_prefix_hint"
                        app:boxStrokeColor="@color/text_high"
                        app:hintTextColor="@color/text_high">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_chat_prefix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_chat_prefix_desc"
                        style="@style/SettingsDesc"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_chat_prefix_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== Защита ===== -->
        <LinearLayout
            android:id="@+id/group_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsCardContent">
                    <TextView style="@style/SettingsCardTitle" android:text="@string/settings_antispam_title" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_antispam_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button android:id="@+id/btn_antispam_off" style="@style/SettingsToggleButton" android:text="@string/settings_antispam_off" />
                        <Button android:id="@+id/btn_antispam_normal" style="@style/SettingsToggleButton" android:text="@string/settings_antispam_normal" />
                        <Button android:id="@+id/btn_antispam_strict" style="@style/SettingsToggleButton" android:text="@string/settings_antispam_strict" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/SettingsDesc" android:text="@string/settings_antispam_desc" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_autoban"
                        style="@style/SettingsSwitch"
                        android:text="@string/settings_autoban_switch" />

                    <TextView style="@style/SettingsDesc" android:text="@string/settings_autoban_desc" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_blacklist"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_blacklist_button"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_block"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/text_low" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== Обучение и управление ===== -->
        <LinearLayout
            android:id="@+id/group_learning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsCardContent">
                    <TextView style="@style/SettingsCardTitle" android:text="@string/owner_title" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/owner_ids_hint"
                        app:boxStrokeColor="@color/text_high"
                        app:hintTextColor="@color/text_high">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_owner_ids"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789, "
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/SettingsDesc"
                        android:layout_marginTop="4dp"
                        android:text="@string/owner_desc" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_unanswered_log"
                        style="@style/SettingsSwitch"
                        android:text="@string/unanswered_log_switch" />

                    <TextView style="@style/SettingsDesc" android:text="@string/unanswered_log_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== Для разработчика ===== -->
        <LinearLayout
            android:id="@+id/group_developer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsCardContent">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_brain_debug"
                        style="@style/SettingsSwitch"
                        android:text="@string/brain_debug_switch" />

                    <TextView style="@style/SettingsDesc" android:text="@string/brain_debug_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
