<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Black and White Theme -->
    <style name="Theme.VKBotManager" parent="Theme.Material3.DayNight">
        <!-- Primary colors -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryVariant">#E0E0E0</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryVariant">#E0E0E0</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">#000000</item>
        <item name="colorOnBackground">#FFFFFF</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#2A2A2A</item>
        <item name="colorOnSurfaceVariant">#FFFFFF</item>
        
        <!-- Error colors -->
        <item name="colorError">#FFFFFF</item>
        <item name="colorOnError">#000000</item>
        
        <!-- ActionBar styling -->
        <item name="actionBarStyle">@style/CustomActionBar</item>
        <item name="android:actionBarStyle">@style/CustomActionBar</item>
        
        <!-- System bars -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/black</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
        
        <!-- Material components -->
        <item name="colorControlNormal">#808080</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlHighlight">#E0E0E0</item>
    </style>
    
    <!-- Custom ActionBar Style -->
    <style name="CustomActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/bg_main</item>
        <item name="titleTextStyle">@style/CustomActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>
    
    <style name="CustomActionBarTitle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>






</resources>